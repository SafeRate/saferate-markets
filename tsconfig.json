{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun-types", "@cloudflare/workers-types"],
		/*
		 * For scripts/ at the repo root only. Bun links workspace packages into
		 * each CONSUMER's node_modules, not the root one, so a root-level file
		 * cannot resolve @markets/* at all; bun honours these paths. Nothing
		 * extends this file, so it cannot change how either Worker is built or
		 * typechecked. (OKLocate's root tsconfig, same reason.)
		 */
		"paths": {
			"@markets/email": ["./packages/email/src/index.ts"],
			"@markets/mcp-tools": ["./packages/mcp-tools/src/index.ts"],
			"@markets/persistence": ["./packages/persistence/src/index.ts"],
			"@markets/schema": ["./packages/schema/src/index.ts"]
		}
	},
	"include": ["scripts/**/*.ts"]
}
